// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite so `bloom create --auth` works with no database server to install:
  // `npx prisma db push` creates dev.db in place and you can sign in.
  //
  // For Postgres, change this to `postgresql` and point DATABASE_URL at your
  // server. The schema below uses no provider-specific types, so nothing else
  // has to change.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  // Primary key is a CUID (short, URL-safe, Prisma-native). Adopted as the
  // Bloom 4.1 framework-wide default so user IDs don't leak sequence
  // information and all templates share the same User shape.
  id                 String    @id @default(cuid())
  email              String    @unique
  password           String
  name               String?
  phone              String?
  role               String    @default("user")
  level              String    @default("basic")
  tenantId           String?
  isVerified         Boolean   @default(false)
  isActive           Boolean   @default(true)
  lastLogin          DateTime?
  resetToken         String?
  resetTokenExpiry   DateTime?
  verificationToken  String?
  verificationExpiry DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Quick Correction: which side of the app this account uses — 'teacher' or
  // 'parent'. Null until the person picks on first sign-in.
  appRole            String?
  students           Student[] @relation("TeacherStudents")
  children           Student[] @relation("ParentChildren")
  papers             Paper[]

  @@index([tenantId]) // MANDATORY: AppKit performance index
  @@map("users")
}


// ── added by the `admin` layer ────────────────────────────────────────────
// Appended to the base schema rather than replacing it, so this composes with
// whatever the auth layer (and any future layer) already declared.

// Append-only trail of consequential actions. Written by audit.service.ts,
// never updated or deleted — an audit log you can edit is not an audit log.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorType   String   @default("user") // 'user' | 'admin' | 'system'
  action      String // e.g. 'user.create', 'settings.update', 'login.failure'
  entityType  String? // e.g. 'user', 'setting', 'session'
  entityId    String? // stringified — entity PKs may vary by model
  oldValue    Json?
  newValue    Json?
  description String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// App settings — a simple key-value store. Strings only; parse at the edge if
// you need numbers or booleans.
//
// `isPublic` controls whether the value is exposed through the
// unauthenticated /api/settings/public endpoint. Default false: a setting is
// private until someone decides otherwise, so adding one cannot leak it.
model AppSetting {
  key         String   @id
  value       String
  isPublic    Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@map("app_settings")
}


// ── Quick Correction ──────────────────────────────────────────────────────
// A teacher has students; a parent links to their child with the student's
// invite code. A paper is a list of question ids from the bank; assigning it
// creates one submission per student, which the parent fills with photos of
// the answer pages and the marker fills with results.

model Student {
  id         String       @id @default(cuid())
  teacherId  String
  teacher    User         @relation("TeacherStudents", fields: [teacherId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     User?        @relation("ParentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  name       String
  className  String       @default("10")
  // Short code the teacher shares with the parent to link the child.
  inviteCode String       @unique
  createdAt  DateTime     @default(now())
  submissions Submission[]

  @@index([teacherId])
  @@index([parentId])
  @@map("students")
}

model Paper {
  id           String       @id @default(cuid())
  teacherId    String
  teacher      User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title        String
  subject      String       @default("Mathematics (Standard)")
  className    String       @default("10")
  pattern      String // 'board' | 'unit'
  durationMins Int
  targetMarks  Int?
  questionIds  Json // string[] of question-bank ids, in paper order
  createdAt    DateTime     @default(now())
  submissions  Submission[]

  @@index([teacherId])
  @@map("papers")
}

model Submission {
  id          String    @id @default(cuid())
  paperId     String
  paper       Paper     @relation(fields: [paperId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status      String    @default("assigned") // 'assigned' | 'evaluating' | 'evaluated' | 'failed'
  dueDate     DateTime
  pages       Json      @default("[]") // storage keys of the uploaded answer pages
  submittedAt DateTime?
  results     Json? // [{ questionId, awarded, max, feedback }]
  score       Int?
  max         Int?
  summary     String?
  // The teacher has checked the marks. Parents see them either way.
  reviewed    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([paperId, studentId])
  @@index([studentId])
  @@map("submissions")
}

// Background jobs for the appkit queue's database transport (picked
// automatically when DATABASE_URL is set). Marking jobs live here, so a
// restart doesn't lose a paper that was waiting to be marked.
model QueueJob {
  id          String    @id @default(cuid())
  queue       String // Job type
  type        String // Job type (compatibility)
  payload     Json // Job data
  result      Json? // Job result
  error       Json? // Error details

  status      String    @default("pending") // pending, processing, completed, failed
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  priority    Int       @default(0)

  runAt       DateTime  @default(now())
  processedAt DateTime?
  completedAt DateTime?
  failedAt    DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([queue, status, priority, runAt])
  @@index([status, runAt])
  @@map("queue_jobs")
}
