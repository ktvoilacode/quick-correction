{
  "name": "quick-correction",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Full-stack FBCA application with UIKit frontend and AppKit backend",
  "keywords": [
    "bloom",
    "react",
    "express",
    "fullstack",
    "fbca"
  ],
  "scripts": {
    "build": "npm run build:web && npm run build:api",
    "build:api": "tsc -p tsconfig.api.json",
    "build:lib": "tsc -p tsconfig.lib.json",
    "build:web": "npm run gen:routes && tsc -b && vite build",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seeding/user.seed.js",
    "db:seed:admin": "node prisma/seeding/settings.seed.js",
    "db:studio": "prisma studio",
    "dev": "npm run gen:routes && concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:web": "vite",
    "gen:routes": "node scripts/gen-api-routes.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "postinstall": "node scripts/copy-agent-docs.js && node scripts/gen-api-routes.mjs",
    "preview": "vite preview",
    "start": "node -e \"if(!require('fs').existsSync('./dist/api/server.js')){console.error('\u274c Build required: run npm run build first');process.exit(1)}\" && node dist/api/server.js",
    "start:api": "node dist/api/server.js",
    "start:prod": "npm run start",
    "start:web": "npm run preview",
    "typecheck": "npm run gen:routes && tsc --noEmit && tsc --noEmit -p tsconfig.api.json",
    "db:seed:qc": "tsx prisma/seeding/qc.seed.ts",
    "db:seed:library": "tsx prisma/seeding/library.seed.ts",
    "db:seed:topics": "tsx prisma/seeding/topics.seed.ts",
    "db:import:ai": "tsx prisma/seeding/ai-questions.import.ts"
  },
  "dependencies": {
    "@bloomneo/appkit": "^5.1.2",
    "@bloomneo/uikit": "^4.1.6",
    "@prisma/client": "^6.2.1",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.436.0",
    "morgan": "^1.10.0",
    "prisma": "^5.19.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0-alpha.26",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^6.0.7"
  }
}
