# Copy to .env and fill in. .env is git-ignored.
DATABASE_URL="file:./dev.db"
BLOOM_AUTH_SECRET=change-me-to-a-long-random-string
DEFAULT_USER_PASSWORD=change-me

# AI marking. Without a key, answer pages get placeholder marks that say so.
ANTHROPIC_API_KEY=
# Optional: the model that marks answer pages (default claude-opus-5-5).
# MARKER_MODEL=claude-opus-5-5
